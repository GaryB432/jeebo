{
	"name": "@jeebo/sv",
	"version": "0.0.1",
	"type": "module",
	"description": "Another command line interface (CLI) for creating and maintaining Svelte applications",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GaryB432/jeebo.git",
		"directory": "packages/sv"
	},
	"homepage": "https://svelte.dev",
	"scripts": {
		"build": "tsdown",
		"check": "tsgo",
		"format": "pnpm lint --write",
		"lint": "prettier --check . --config ../../prettier.config.js --ignore-path ../../.gitignore --ignore-path .gitignore --ignore-path ../../.prettierignore"
	},
	"files": [
		"dist"
	],
	"bin": "./dist/bin.mjs",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.mts",
			"default": "./dist/lib/index.mjs"
		},
		"./testing": {
			"types": "./dist/lib/testing.d.mts",
			"default": "./dist/lib/testing.mjs"
		},
		"./core": {
			"types": "./dist/lib/core.d.mts",
			"default": "./dist/lib/core.mjs"
		}
	},
	"dependencies": {
		"sv": "^0.11.3"
	},
	"keywords": [
		"create",
		"new",
		"project",
		"starter",
		"svelte",
		"sveltekit",
		"template",
		"wizard"
	]
}
