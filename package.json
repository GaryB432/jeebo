{
	"name": "@jeebo/source",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "monorepo for sv and friends",
	"engines": {
		"pnpm": "^10.0.0"
	},
	"scripts": {
		"build": "pnpm --recursive run build",
		"changeset:publish": "changeset publish",
		"check": "pnpm --parallel check",
		"dev": "tsdown -w & pnpm --parallel check -w & wait",
		"format": "pnpm --parallel format",
		"lint": "pnpm --parallel lint && eslint --cache --cache-location node_modules/.eslintcache",
		"test": "vitest run --silent",
		"test:ecosystem-ci": "vitest run --exclude='**/storybook/test.ts'",
		"test:ui": "vitest --ui",
		"update-deps": "node ./scripts/update-dependencies.js && pnpm format"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"@clack/prompts": "1.0.0-alpha.9",
		"@jeebo/sv": "workspace:*",
		"@playwright/test": "^1.57.0",
		"@sveltejs/eslint-config": "^8.3.4",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@types/degit": "^2.8.6",
		"@types/estree": "^1.0.8",
		"@types/gitignore-parser": "^0.0.3",
		"@types/node": "^20.14.8",
		"@types/prompts": "^2.4.9",
		"@types/ps-tree": "^1.1.6",
		"@types/semver": "^7.7.1",
		"@types/tar-fs": "^2.0.4",
		"@typescript/native-preview": "7.0.0-dev.20251212.1",
		"@vitest/ui": "4.0.15",
		"commander": "^14.0.2",
		"decircular": "^1.0.0",
		"dedent": "^1.7.0",
		"degit": "^2.8.4",
		"empathic": "^2.0.0",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.13.1",
		"esrap": "^2.2.2",
		"gitignore-parser": "^0.0.2",
		"magic-string": "^0.30.21",
		"package-manager-detector": "^1.6.0",
		"prettier": "^3.7.4",
		"prettier-plugin-packagejson": "^2.5.20",
		"prettier-plugin-svelte": "^3.4.0",
		"ps-tree": "^1.2.0",
		"silver-fleece": "^1.2.1",
		"smol-toml": "^1.5.2",
		"sucrase": "^3.35.1",
		"svelte": "^5.45.10",
		"tar-fs": "^3.1.1",
		"tiny-glob": "^0.2.9",
		"tinyexec": "^1.0.2",
		"tsdown": "^0.18.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"valibot": "^1.2.0",
		"vitest": "4.0.15",
		"yaml": "^2.8.2",
		"zimmerframe": "^1.1.4"
	},
	"packageManager": "pnpm@10.25.0"
}
